# Copy to .env, fill in the values, and run: chmod 600 .env
MINERVA_USERNAME=
MINERVA_PASSWORD=
# Base32 authenticator seed, not the current six-digit code.
MINERVA_TOTP_SECRET=
# Optional when geckodriver is not on PATH:
# GECKODRIVER_PATH=/usr/bin/geckodriver

# Poll configuration. Example: 202609 and COMP:350,MATH:240
MINERVA_TERM=
MINERVA_COURSES=
# Explicitly opt in to registration-changing automatic waitlist submissions.
MINERVA_AUTO_WAITLIST=false

# Required for poll notifications unless --no-notify is used.
NTFY_TOPIC=
# Optional for self-hosted ntfy or protected topics:
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=tk_example
# Optional click target; must remain on https://horizon.mcgill.ca:
# MINERVA_REGISTRATION_URL=https://horizon.mcgill.ca/pban1/twbkwbis.P_GenMenu?name=bmenu.P_RegMnu
